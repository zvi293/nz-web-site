---
// Signature component: מהאפר לכלי — flick-to-spin potter's wheel (momentum builds the vessel)
/**
 * The potter's wheel. A mound of ash-grey clay sits centred on a wheel head; the visitor throws
 * it into a vessel by spinning the wheel: drag/flick it sideways (touch or mouse; the wheel keeps
 * turning with momentum and slows down), or press the button (one stage per press). The turns
 * themselves do the work: every ~1½ turns the clay passes one stage, and at each stop the shape
 * shows that stage's verb: centred mound (מרכזים) → opened bowl (פותחים) → pulled cylinder
 * (מושכים) → trimmed vase (מהדקים) → the vase glowing in the kiln (שורפים) → cooled to a
 * bone-white glaze with a vermilion lip (הכלי מוכן). The matching line of the log lights: each
 * stage is also a stage of building the site (הקשבה → אפיון → עיצוב → קוד → השקה).
 *
 * Drawing: a thin wheel head (an ellipse seen from slightly above) in a darker splash pan; short
 * light streaks on the head turn with the wheel; tiny grog dots ride the clay's surface; the clay
 * sits ON the head (its base follows the head's ellipse, with a contact shadow), and an open form
 * shows its rim and dark mouth.
 *
 * Small bundled vanilla script (no React, no libraries); rAF runs only while the wheel turns.
 * Accessibility: a real button drives it (one stage per press), the figure's label and a
 * polite live region say the stage in words, the current log item has aria-current="step".
 * No JS: the finished vessel and the whole log are shown. Reduced motion / a11y pause: the
 * button and drag still work, but every change is instant (no momentum, no nudge).
 */
import { aboutWheel as w } from "@/content/about";

const CX = 200;
const BASE = 318;
/** perspective: a circle of radius r on the head plane is an ellipse r × r·K */
const K = 0.18;
const HEAD = 150;
/* The finished vessel (server render = the no-JS state). Same math as the script below. */
const VASE: [number, number][] = [
  [56, 0], [78, 28], [92, 64], [92, 100], [80, 136], [56, 168], [40, 192], [42, 210], [52, 224],
];
function outline(pts: [number, number][]) {
  const R = pts.map(([r, h]) => [CX + r, BASE - h]);
  const L = pts.map(([r, h]) => [CX - r, BASE - h]).reverse();
  const curve = (P: number[][]) => {
    let d = "";
    for (let i = 0; i < P.length - 1; i++) {
      const p0 = P[i - 1] ?? P[i], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2] ?? P[i + 1];
      const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
      const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
      d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
    }
    return d;
  };
  const r0 = pts[0][0];
  /* the base follows the front of its own ellipse on the head: the clay sits on the wheel */
  return `M${L[L.length - 1][0]} ${L[L.length - 1][1]} A${r0} ${(r0 * K).toFixed(1)} 0 0 0 ${R[0][0]} ${R[0][1]}${curve(R)} L${L[0][0]} ${L[0][1]}${curve(L)} Z`;
}
/** short arcs on the head that turn with it */
const STREAKS = 7;
function streak(i: number, angle: number) {
  const R = HEAD * 0.74;
  const a0 = (angle * Math.PI) / 180 + (i * 2 * Math.PI) / STREAKS;
  const pts = [0, 1, 2, 3].map((k) => {
    const t = a0 + k * 0.1;
    return `${(CX + R * Math.sin(t)).toFixed(1)} ${(BASE + R * K * Math.cos(t)).toFixed(1)}`;
  });
  return `M${pts.join(" L")}`;
}
const finalD = outline(VASE);
const top = VASE[VASE.length - 1];
const stagesJson = JSON.stringify(w.stages.map((s) => ({ verb: s.verb, work: s.work })));
---

<section class="nz-section nz-section--space-default ab-wheel" data-tone="ink" aria-labelledby="ab-wheel-title">
  <div class="nz-container ab-wheel__grid">
    <header class="ab-wheel__head">
      <p class="nz-label ab-wheel__room">
        <span class="nz-label__index">{w.room}</span>
        <span>{w.label}</span>
      </p>
      <h2 id="ab-wheel-title" class="nz-display nz-display--h2 ab-wheel__title">{w.title}</h2>
      <p class="nz-lede ab-wheel__lede">{w.lede}</p>
    </header>

    <div class="ab-wheel__stage" data-ab-wheel data-stages={stagesJson} data-done={w.done} data-done-work={w.doneWork} data-spin={w.spin} data-again={w.again}>
      <p class="ab-wheel__readout" aria-hidden="true">
        <span class="ab-wheel__count" data-ab-count>{w.done}</span>
        <span class="ab-wheel__verb" data-ab-verb>{w.doneWork}</span>
        {/* phones: the log is below the fold, so the stage's own line is read here (all stacked in one cell: no jump) */}
        <span class="ab-wheel__lines">
          {w.stages.map((s) => <span class="ab-wheel__line">{s.line}</span>)}
          <span class="ab-wheel__line" data-on>{w.doneLine}</span>
        </span>
      </p>
      <figure class="ab-wheel__fig">
        <svg class="ab-wheel__svg" viewBox="0 56 400 344" role="img" aria-label={`כלי על האבניים: ${w.done}`} data-ab-svg>
          <defs>
            <linearGradient id="ab-shade" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#000" stop-opacity="0.5"></stop>
              <stop offset="0.38" stop-color="#fff" stop-opacity="0.16"></stop>
              <stop offset="0.55" stop-color="#fff" stop-opacity="0.04"></stop>
              <stop offset="1" stop-color="#000" stop-opacity="0.58"></stop>
            </linearGradient>
            <radialGradient id="ab-light" cx="0.5" cy="0.55" r="0.5">
              <stop offset="0" stop-color="#efeae2" stop-opacity="0.1"></stop>
              <stop offset="1" stop-color="#efeae2" stop-opacity="0"></stop>
            </radialGradient>
            <radialGradient id="ab-headtop" cx="0.42" cy="0.35" r="0.75">
              <stop offset="0" stop-color="#57514a"></stop>
              <stop offset="1" stop-color="#36322d"></stop>
            </radialGradient>
            <radialGradient id="ab-seat" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0.55" stop-color="#000" stop-opacity="0.55"></stop>
              <stop offset="1" stop-color="#000" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <ellipse cx="200" cy="250" rx="200" ry="170" fill="url(#ab-light)"></ellipse>
          <!-- the splash pan around the wheel, then the floor shadow under it -->
          <ellipse cx="200" cy="384" rx="176" ry="12" fill="#000" opacity="0.4"></ellipse>
          <path class="ab-wheel__pan-side" d="M22 330 A178 38 0 0 0 378 330 L378 352 A178 38 0 0 1 22 352 Z"></path>
          <ellipse class="ab-wheel__pan" cx="200" cy="330" rx="178" ry="38"></ellipse>
          <ellipse class="ab-wheel__pan-in" cx="200" cy="332" rx="166" ry="32"></ellipse>
          <!-- the wheel head: a thin disc -->
          <path class="ab-wheel__side" d={`M${CX - HEAD} ${BASE} A${HEAD} ${HEAD * K} 0 0 0 ${CX + HEAD} ${BASE} L${CX + HEAD} ${BASE + 7} A${HEAD} ${HEAD * K} 0 0 1 ${CX - HEAD} ${BASE + 7} Z`}></path>
          <ellipse class="ab-wheel__head-top" cx={CX} cy={BASE} rx={HEAD} ry={HEAD * K} fill="url(#ab-headtop)"></ellipse>
          <ellipse class="ab-wheel__ring" cx={CX} cy={BASE} rx={HEAD * 0.9} ry={HEAD * 0.9 * K}></ellipse>
          <g class="ab-wheel__streaks" data-ab-streaks>
            {Array.from({ length: STREAKS }, (_, i) => <path d={streak(i, 0)} />)}
          </g>
          <!-- the clay -->
          <ellipse class="ab-clay__seat" cx={CX} cy={BASE + 2} rx={VASE[0][0] + 10} ry={(VASE[0][0] + 10) * K} fill="url(#ab-seat)" data-ab-seat></ellipse>
          <path class="ab-clay__glow" d={finalD} data-ab-glow></path>
          <path class="ab-clay__body" d={finalD} fill="#ebe4d9" data-ab-body></path>
          <path class="ab-clay__shade" d={finalD} fill="url(#ab-shade)" data-ab-shade></path>
          <g class="ab-clay__grog" data-ab-grog>
            <circle r="1.3"></circle>
            <circle r="1.1"></circle>
            <circle r="1.4"></circle>
            <circle r="1"></circle>
            <circle r="1.2"></circle>
            <circle r="1.3"></circle>
            <circle r="1.1"></circle>
          </g>
          <ellipse class="ab-clay__rim" cx={CX} cy={BASE - top[1]} rx={top[0]} ry={top[0] * K} fill="#d9461f" data-ab-rim></ellipse>
          <ellipse class="ab-clay__mouth" cx={CX} cy={BASE - top[1] + 1} rx={top[0] - 5} ry={(top[0] - 5) * K} fill="#c9461f" data-ab-mouth></ellipse>
        </svg>
      </figure>

      <div class="ab-wheel__controls">
        <button type="button" class="ab-wheel__spin" data-ab-spin aria-describedby="ab-wheel-hint">
          <span class="ab-wheel__spin-icon" aria-hidden="true"></span>
          <span data-ab-spin-label>{w.spin}</span>
        </button>
        <p class="ab-wheel__hint" id="ab-wheel-hint">{w.hint}</p>
      </div>
      <p class="nz-sr" aria-live="polite" data-ab-live></p>
    </div>

    <div class="ab-wheel__logwrap">
      <p class="nz-label ab-wheel__loglabel" id="ab-wheel-log">{w.logLabel}</p>
      <ol class="ab-log" aria-labelledby="ab-wheel-log" data-ab-log>
        {
          w.stages.map((s, i) => (
            <li class="ab-log__item" data-state="done">
              <span class="ab-log__dot" aria-hidden="true" />
              <p class="ab-log__name">
                <span class="ab-log__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="ab-log__verb">{s.verb}</span>
                <span class="ab-log__work">· {s.work}</span>
              </p>
              <p class="ab-log__line">{s.line}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  /* מהאפר לכלי — the wheel. No scroll listeners; rAF only while it turns. */
  type Pt = [number, number];
  const CX = 200;
  const BASE = 318;
  const K = 0.18;
  const HEAD = 150;
  const STREAKS = 7;
  const DEG_PER_STAGE = 540;
  const VASE: Pt[] = [[56, 0], [78, 28], [92, 64], [92, 100], [80, 136], [56, 168], [40, 192], [42, 210], [52, 224]];
  /* the shape at each stop (p = 0…5): centred mound, opened bowl, pulled cylinder, trimmed vase,
     the vase in the kiln, the glazed vase */
  const SHAPES: Pt[][] = [
    [[92, 0], [96, 14], [94, 30], [86, 46], [74, 60], [58, 72], [40, 82], [20, 89], [0, 92]],
    [[72, 0], [86, 8], [97, 19], [105, 32], [110, 45], [112, 57], [112, 67], [111, 75], [110, 80]],
    [[70, 0], [72, 30], [72, 62], [71, 94], [70, 126], [69, 158], [68, 186], [67, 208], [66, 224]],
    VASE,
    VASE,
    VASE,
  ];
  /* tiny grog in the clay: [height fraction, azimuth] */
  const GROG: [number, number][] = [
    [0.14, 0.3], [0.32, 2.2], [0.47, 4.1], [0.61, 1.2], [0.76, 3.2], [0.88, 5.3], [0.24, 5.9],
  ];

  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  /** the shape morphs symmetrically between two stops, so it matches the named stage (= the nearest stop) */
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const mix = (a: string, b: string, t: number) => {
    const A = hex(a), B = hex(b);
    return `rgb(${A.map((v, i) => Math.round(v + (B[i] - v) * Math.min(1, Math.max(0, t)))).join(",")})`;
  };
  /** colour ramps along p (0–5): [p, body, mouth, rim] */
  const RAMP: [number, string, string, string][] = [
    [0, "#77716a", "#2e2a26", "#8a847c"],
    [1, "#8a6b55", "#3a2c23", "#a08068"],
    [3, "#a07f66", "#4a3427", "#b8977c"],
    [4, "#d9582a", "#6e2410", "#f08a4f"],
    [4.6, "#e6d8c8", "#b8442a", "#efe6da"],
    [5, "#ebe4d9", "#c9461f", "#d9461f"],
  ];
  const ramp = (p: number, k: 1 | 2 | 3) => {
    for (let i = 0; i < RAMP.length - 1; i++) {
      const [a, b] = [RAMP[i], RAMP[i + 1]];
      if (p <= b[0]) return mix(a[k], b[k], (p - a[0]) / (b[0] - a[0]));
    }
    return RAMP[RAMP.length - 1][k];
  };

  function profile(p: number): Pt[] {
    const i = Math.min(4, Math.floor(p));
    const t = smooth(Math.min(1, p - i));
    return SHAPES[i].map(([r, h], j) => [r + (SHAPES[i + 1][j][0] - r) * t, h + (SHAPES[i + 1][j][1] - h) * t]);
  }
  function outline(pts: Pt[]) {
    const R = pts.map(([r, h]) => [CX + r, BASE - h]);
    const L = pts.map(([r, h]) => [CX - r, BASE - h]).reverse();
    const curve = (P: number[][]) => {
      let d = "";
      for (let i = 0; i < P.length - 1; i++) {
        const p0 = P[i - 1] ?? P[i], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2] ?? P[i + 1];
        d += ` C${(p1[0] + (p2[0] - p0[0]) / 6).toFixed(1)} ${(p1[1] + (p2[1] - p0[1]) / 6).toFixed(1)} ${(p2[0] - (p3[0] - p1[0]) / 6).toFixed(1)} ${(p2[1] - (p3[1] - p1[1]) / 6).toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
      }
      return d;
    };
    const r0 = pts[0][0];
    return `M${L[L.length - 1][0].toFixed(1)} ${L[L.length - 1][1].toFixed(1)} A${r0.toFixed(1)} ${(r0 * K).toFixed(1)} 0 0 0 ${R[0][0].toFixed(1)} ${R[0][1].toFixed(1)}${curve(R)} L${L[0][0].toFixed(1)} ${L[0][1].toFixed(1)}${curve(L)} Z`;
  }
  /** half-width of the profile at height h (linear between samples) */
  function radiusAt(pts: Pt[], h: number) {
    for (let j = 0; j < pts.length - 1; j++) {
      if (h <= pts[j + 1][1]) {
        const t = (h - pts[j][1]) / Math.max(0.001, pts[j + 1][1] - pts[j][1]);
        return pts[j][0] + (pts[j + 1][0] - pts[j][0]) * t;
      }
    }
    return pts[pts.length - 1][0];
  }
  function streak(i: number, angle: number) {
    const R = HEAD * 0.74;
    const a0 = (angle * Math.PI) / 180 + (i * 2 * Math.PI) / STREAKS;
    let d = "";
    for (let k = 0; k < 4; k++) {
      const t = a0 + k * 0.1;
      d += `${k ? " L" : "M"}${(CX + R * Math.sin(t)).toFixed(1)} ${(BASE + R * K * Math.cos(t)).toFixed(1)}`;
    }
    return { d, front: Math.cos(a0 + 0.15) };
  }

  const root = document.querySelector<HTMLElement>("[data-ab-wheel]");
  if (root) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const svg = q<SVGSVGElement>("[data-ab-svg]");
    const body = q<SVGPathElement>("[data-ab-body]");
    const shade = q<SVGPathElement>("[data-ab-shade]");
    const glow = q<SVGPathElement>("[data-ab-glow]");
    const rim = q<SVGEllipseElement>("[data-ab-rim]");
    const mouth = q<SVGEllipseElement>("[data-ab-mouth]");
    const seat = q<SVGEllipseElement>("[data-ab-seat]");
    const streaks = Array.from(root.querySelectorAll<SVGPathElement>("[data-ab-streaks] path"));
    const grog = Array.from(root.querySelectorAll<SVGCircleElement>("[data-ab-grog] circle"));
    const btn = q<HTMLButtonElement>("[data-ab-spin]");
    const btnLabel = q<HTMLElement>("[data-ab-spin-label]");
    const count = q<HTMLElement>("[data-ab-count]");
    const verb = q<HTMLElement>("[data-ab-verb]");
    const lines = Array.from(root.querySelectorAll<HTMLElement>(".ab-wheel__line"));
    const live = q<HTMLElement>("[data-ab-live]");
    const fig = q<HTMLElement>(".ab-wheel__fig");
    const log = Array.from(document.querySelectorAll<HTMLElement>("[data-ab-log] > li"));
    const stages: { verb: string; work: string }[] = JSON.parse(root.dataset.stages || "[]");
    const N = stages.length;
    const motionOn = () => document.documentElement.classList.contains("nz-motion");

    let p = 0;
    let angle = 0;
    let v = 0; // deg/s
    let dragging = false;
    let lastX = 0;
    let lastT = 0;
    let free = false; // a spin that does not work the clay (the first-view nudge)
    let tween: { from: number; to: number; t0: number; dur: number; a0: number; a1: number } | null = null;
    let raf = 0;
    let shownStage = -1;

    /* the named stage is the nearest stop: the drawing is closest to that shape */
    const stageOf = (x: number) => Math.min(N, Math.round(x));

    function render() {
      const pts = profile(Math.min(5, p));
      const d = outline(pts);
      body.setAttribute("d", d);
      shade.setAttribute("d", d);
      glow.setAttribute("d", d);
      body.setAttribute("fill", ramp(p, 1));
      const r0 = pts[0][0];
      seat.setAttribute("rx", (r0 + 10).toFixed(1));
      seat.setAttribute("ry", ((r0 + 10) * K).toFixed(1));
      const top = pts[pts.length - 1];
      const open = top[0] > 6;
      rim.style.opacity = open ? "1" : "0";
      mouth.style.opacity = open ? "1" : "0";
      if (open) {
        const cy = BASE - top[1];
        rim.setAttribute("cy", cy.toFixed(1));
        rim.setAttribute("rx", top[0].toFixed(1));
        rim.setAttribute("ry", (top[0] * K).toFixed(1));
        rim.setAttribute("fill", ramp(p, 3));
        const ri = Math.max(1, top[0] - 5);
        mouth.setAttribute("cy", (cy + 1).toFixed(1));
        mouth.setAttribute("rx", ri.toFixed(1));
        mouth.setAttribute("ry", (ri * K).toFixed(1));
        mouth.setAttribute("fill", ramp(p, 2));
      }
      glow.style.opacity = String(Math.max(0, 1 - Math.abs(p - 4) / 0.8) * 0.95);
      streaks.forEach((s, i) => {
        const { d: sd, front } = streak(i, angle);
        s.setAttribute("d", sd);
        s.style.opacity = (0.2 + 0.45 * ((front + 1) / 2)).toFixed(2);
      });
      const rad = (angle * Math.PI) / 180;
      const height = top[1];
      const glazed = p > 4.4;
      grog.forEach((g, i) => {
        const [fh, ph] = GROG[i];
        const h = height * fh;
        const r = radiusAt(pts, h) - 1.5;
        const a = rad + ph;
        const front = Math.cos(a);
        const vis = !glazed && r > 8 && front > 0.05;
        g.style.opacity = vis ? (Math.min(1, front * 1.6) * 0.75).toFixed(2) : "0";
        g.setAttribute("cx", (CX + r * Math.sin(a)).toFixed(1));
        g.setAttribute("cy", (BASE - h + r * K * front).toFixed(1));
      });

      const st = stageOf(p);
      if (st !== shownStage) {
        shownStage = st;
        log.forEach((li, i) => {
          const state = i < st ? "done" : i === st ? "current" : "todo";
          li.dataset.state = state;
          if (state === "current") li.setAttribute("aria-current", "step");
          else li.removeAttribute("aria-current");
        });
        lines.forEach((l, i) => l.toggleAttribute("data-on", i === Math.min(st, N)));
        if (st >= N) {
          count.textContent = root!.dataset.done || "";
          verb.textContent = root!.dataset.doneWork || "";
          btnLabel.textContent = root!.dataset.again || "";
          svg.setAttribute("aria-label", `כלי על האבניים: ${root!.dataset.done}, ${root!.dataset.doneWork}`);
        } else {
          count.textContent = `שלב ${st + 1} מתוך ${N}`;
          verb.textContent = `${stages[st].verb} · ${stages[st].work}`;
          btnLabel.textContent = root!.dataset.spin || "";
          svg.setAttribute("aria-label", `כלי על האבניים, שלב ${st + 1} מתוך ${N}: ${stages[st].verb}, ${stages[st].work}`);
        }
        root!.dataset.stage = String(st);
      }
    }

    function announce() {
      const st = stageOf(p);
      live.textContent =
        st >= N
          ? `${root!.dataset.done}: ${root!.dataset.doneWork}.`
          : `שלב ${st + 1} מתוך ${N}: ${stages[st].verb}, ${stages[st].work}.`;
    }

    function frame(now: number) {
      const dt = Math.min(0.05, (now - lastT) / 1000 || 0.016);
      lastT = now;
      let active = false;
      if (tween) {
        const t = Math.min(1, (now - tween.t0) / tween.dur);
        const e = ease(t);
        p = tween.from + (tween.to - tween.from) * e;
        angle = tween.a0 + (tween.a1 - tween.a0) * e;
        if (t >= 1) {
          tween = null;
          announce();
        } else active = true;
      } else if (!dragging && Math.abs(v) > 6) {
        const da = v * dt;
        angle += da;
        if (!free && p < N) {
          const before = stageOf(p);
          p = Math.min(N, p + Math.abs(da) / DEG_PER_STAGE);
          if (stageOf(p) !== before) announce();
        }
        v *= Math.exp(-dt * 1.35);
        active = true;
      } else if (dragging) active = true;
      else free = false;
      render();
      raf = active ? requestAnimationFrame(frame) : 0;
    }
    const run = () => {
      if (!raf) {
        lastT = performance.now();
        raf = requestAnimationFrame(frame);
      }
    };

    /* the button: one stage per press; at the end, throw a new vessel */
    btn.addEventListener("click", () => {
      v = 0;
      free = false;
      const from = p;
      const to = p >= N - 0.001 ? 0 : Math.min(N, Math.round(p) + 1);
      if (!motionOn()) {
        p = to;
        render();
        announce();
        return;
      }
      const back = to < from;
      tween = {
        from,
        to,
        t0: performance.now(),
        dur: back ? 700 : 1300,
        a0: angle,
        a1: angle + (back ? -200 : DEG_PER_STAGE * Math.max(0.4, to - from)),
      };
      run();
    });

    /* drag / flick the wheel sideways (vertical drags keep scrolling the page: touch-action) */
    fig.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      dragging = true;
      tween = null;
      free = false;
      v = 0;
      lastX = e.clientX;
      fig.setPointerCapture(e.pointerId);
      root.classList.add("is-dragging");
      run();
    });
    fig.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const scale = 400 / fig.getBoundingClientRect().width;
      const dx = (e.clientX - lastX) * scale;
      lastX = e.clientX;
      const da = -dx * 1.35; // pushing the near side of the wheel
      angle += da;
      if (p < N) {
        const before = stageOf(p);
        p = Math.min(N, p + Math.abs(da) / DEG_PER_STAGE);
        if (stageOf(p) !== before) announce();
      }
      const now = performance.now();
      const inst = da / Math.max(0.008, (now - lastT) / 1000);
      v = v * 0.6 + inst * 0.4;
      lastT = now;
      render();
    });
    const release = () => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove("is-dragging");
      if (!motionOn()) v = 0;
      v = Math.max(-1600, Math.min(1600, v));
      lastT = performance.now();
      run();
    };
    fig.addEventListener("pointerup", release);
    fig.addEventListener("pointercancel", release);

    /* start from a lump of ash; a single nudge of the wheel the first time it is seen */
    p = 0;
    render();
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          if (!motionOn() || p > 0) return;
          free = true;
          v = 420;
          run();
        },
        { threshold: 0.6 },
      );
      io.observe(fig);
    }
  }
</script>
