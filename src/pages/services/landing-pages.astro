---
/**
 * /services/landing-pages/ — בניית דפי נחיתה. Service system page (src/components/service).
 * Content: src/components/pages/landing-pages/data.ts. Static sections (page-born: LeakMap,
 * AdStack); ONE island: the signature "סולם ההמרה" (hand-over-hand climb, client:visible).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceHero from "@/components/service/ServiceHero.astro";
import SignatureSlot from "@/components/service/SignatureSlot.astro";
import ServiceDeepDive from "@/components/service/ServiceDeepDive.astro";
import ServiceProcess from "@/components/service/ServiceProcess.astro";
import ServiceOutcomes from "@/components/service/ServiceOutcomes.astro";
import ServiceFaq from "@/components/service/ServiceFaq.astro";
import ServiceRelated from "@/components/service/ServiceRelated.astro";
import ServiceCta from "@/components/service/ServiceCta.astro";
import LeakMap from "@/components/pages/landing-pages/LeakMap.astro";
import AdStack from "@/components/pages/landing-pages/AdStack.astro";
import ConversionLadder from "@/components/pages/landing-pages/ConversionLadder";
import { landingPages as page } from "@/components/pages/landing-pages/data";
import { serviceSeo } from "@/lib/page-seo";

const seo = serviceSeo(page);
---

<BaseLayout seo={seo} mainClass="relative bg-bone pt-[var(--header-h)]">
  <ServiceHero data={page.hero} variant={page.heroVariant} path={page.path} crumb={page.crumb} position="30% 50%" />

  <LeakMap index="01" />

  <SignatureSlot
    name="סולם ההמרה"
    title="שישה שלבים מהקליק אל הפנייה"
    lede="דף נחיתה טוב הוא סולם: כל חלק בו מעלה את המבקר שלב אחד, מהמודעה שעליה לחץ ועד הטופס. עזרו לו לטפס על דף לדוגמה, יד אחרי יד. כל שלב מדליק את החלק בדף שבו הוא עובד."
    hint="הקישו לסירוגין על יד ימין ועל יד שמאל, וכל משיכה מעלה שלב. אותה יד פעמיים מחליקה."
    keys="במקלדת: Tab לכפתורי הידיים ו-Enter, או חץ ימינה ושמאלה לסירוגין."
    opener="split"
    index="02"
    id="lnd-sig"
  >
    <ConversionLadder client:visible />
  </SignatureSlot>

  <AdStack title={page.whoFor!.title} lede={page.whoFor!.lede} items={page.whoFor!.items} index="03" />

  <ServiceOutcomes title={page.outcomes!.title} items={page.outcomes!.items} index="04" opener="quote" id="lnd-outcomes" />

  <ServiceDeepDive data={page.deepDive!} variant="ledger" tone="bone" opener="rule" index="05" label="מה כולל" id="lnd-deep" />

  <ServiceProcess
    title={page.process!.title}
    lede={page.process!.lede}
    steps={page.process!.steps}
    tone="paper"
    opener="stacked"
    index="06"
    art={["marble-maze", "origami-crane", "kinetic-balance", "emerald-curtain"]}
    avoid={[page.hero.art, "paper-plane", "lime-prism", "titanium-ribbon"]}
    id="lnd-process"
  />

  <ServiceFaq items={page.faqs} title="שאלות על בניית דפי נחיתה" index="07" card="plaque" tone="bone" id="lnd-faq" />

  <ServiceRelated currentPath={page.path} items={page.related} />

  <ServiceCta data={page.cta!} label="הזמנה לשיחה · דף נחיתה" />
</BaseLayout>
