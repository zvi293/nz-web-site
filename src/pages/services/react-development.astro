---
/**
 * /services/react-development/ — פיתוח React (room 07, art indigo-loom).
 * Service system sections (src/components/service) + page-local pieces in
 * src/components/pages/react-development/ (content: data.ts there): the opening essay with its
 * framed detail ("רכיב אחד, מקרוב"), the punch card, the yes/no decision diagram and the outcomes
 * drawn as component trees (ReactOutcomes, instead of the kit's framed-word triptych).
 * ONE island: the signature "רינדור חי" (type → live highlight, client:visible).
 * `rd-page` on <main> lets react-development.css hang the hero work first on phones.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceHero from "@/components/service/ServiceHero.astro";
import SignatureSlot from "@/components/service/SignatureSlot.astro";
import ServiceFaq from "@/components/service/ServiceFaq.astro";
import ServiceRelated from "@/components/service/ServiceRelated.astro";
import ServiceCta from "@/components/service/ServiceCta.astro";
import OneComponent from "@/components/pages/react-development/OneComponent.astro";
import PunchCard from "@/components/pages/react-development/PunchCard.astro";
import ReactDecision from "@/components/pages/react-development/ReactDecision.astro";
import ReactOutcomes from "@/components/pages/react-development/ReactOutcomes.astro";
import LiveRender from "@/components/pages/react-development/LiveRender";
import { reactDevelopment as page } from "@/components/pages/react-development/data";
import { serviceSeo } from "@/lib/page-seo";
import "@/components/pages/react-development/react-development.css";

const seo = serviceSeo(page);
---

<BaseLayout seo={seo} mainClass="relative bg-bone pt-[var(--header-h)] rd-page">
  <ServiceHero data={page.hero} variant={page.heroVariant} path={page.path} crumb={page.crumb} />

  <SignatureSlot
    name="רינדור חי"
    title="הקלידו, וראו מה מתעדכן"
    lede="חנות תה קטנה שבנויה מרכיבים, ולצידה עץ הרכיבים שלה. הקלידו בחיפוש או שימו תה בסל, וראו אילו רכיבים מצטיירים מחדש. כל השאר לא זז, וזה בדיוק מה שהופך ממשק React למהיר."
    hint="הקלידו בשדה החיפוש, או הקישו על 'הקלידו בשבילי' ועל 'לסל'. כל רכיב שהתעדכן מסומן בחנות עם מספר הפעמים שצויר. המתג 'בלי חלוקה לרכיבים' מראה מה היה קורה אילו כל העמוד היה נבנה מחדש בכל שינוי."
    keys="במקלדת: Tab בין השדה, הכפתורים והמתג; רווח או Enter מפעילים."
    opener="rule"
    index="מוצג חי"
  >
    <LiveRender client:visible />
  </SignatureSlot>

  <OneComponent index="01" />

  <PunchCard index="02" />

  <ReactDecision index="03" />

  <ReactOutcomes title={page.outcomes!.title} items={page.outcomes!.items} index="04" />

  <ServiceFaq items={page.faqs} title="שאלות על פיתוח React" tone="paper" card="plaque" opener="rule" index="05" />

  <ServiceRelated currentPath={page.path} items={page.related} />

  <ServiceCta data={page.cta!} label="פרויקט React" />
</BaseLayout>
