---
/**
 * /projects/ — "האוסף": the real works, hung as a salon wall.
 * Static sections (src/components/projects) + ONE island:
 *   SalonWall  client:visible  the signature "קיר הסלון" (salon hang → framed lightbox <dialog>)
 * Page CSS: src/components/projects/projects.css (prefix `pj-`).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectsHero, { PROJECTS_HERO_SIZES, PROJECTS_HERO_SLUG } from "@/components/projects/ProjectsHero";
import ProjectsSalon from "@/components/projects/ProjectsSalon";
import SalonWall from "@/components/projects/SalonWall";
import ProjectsCatalogue from "@/components/projects/ProjectsCatalogue";
import ProjectsLabel from "@/components/projects/ProjectsLabel";
import ProjectsNext from "@/components/projects/ProjectsNext";
import "@/components/projects/projects.css";
import { projectsCopy } from "@/components/projects/copy";
import { works } from "@/components/projects/works";
import { collectionPage, OG_IMAGES } from "@/lib/schema";
import { heroImage, type PageSeo } from "@/lib/seo";

const PATH = "/projects/";
const { title, description, breadcrumb } = projectsCopy.seo;

const seo: PageSeo = {
  path: PATH,
  title,
  description,
  ogImage: OG_IMAGES.projects,
  lcpArt: { slug: PROJECTS_HERO_SLUG, sizes: PROJECTS_HERO_SIZES },
  breadcrumb: { name: breadcrumb, path: PATH },
  jsonLd: collectionPage({
    path: PATH,
    title,
    description,
    primaryImage: heroImage(PROJECTS_HERO_SLUG, PATH),
    speakable: true,
    items: works.map((w) => ({ name: w.title, url: w.link, description: w.description, image: w.desktop.src })),
  }),
};
---

<BaseLayout seo={seo} mainClass="relative bg-bone pt-[var(--header-h)]">
  <ProjectsHero />
  <ProjectsSalon>
    <SalonWall client:visible />
  </ProjectsSalon>
  <ProjectsCatalogue />
  <ProjectsLabel />
  <ProjectsNext />
</BaseLayout>
