---
/**
 * /packages/ — "ההצעה": the single tailored offer (URL kept for SEO; no packages, no prices).
 * Sections are static React components (src/components/offer); ONE island:
 *   ScopeBubble  client:visible  the signature "בועת ההיקף" (toss/fling stones into a bubble)
 * Page CSS: src/components/offer/offer.css (prefix `of-`).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import OfferHero, { OFFER_HERO_SIZES, OFFER_HERO_SLUG } from "@/components/offer/OfferHero";
import OfferModel from "@/components/offer/OfferModel";
import OfferScope from "@/components/offer/OfferScope";
import ScopeBubble from "@/components/offer/ScopeBubble";
import OfferCare from "@/components/offer/OfferCare";
import OfferOwnership from "@/components/offer/OfferOwnership";
import OfferQuote from "@/components/offer/OfferQuote";
import OfferFaq from "@/components/offer/OfferFaq";
import "@/components/offer/offer.css";
import { offerPage, offerPageFaq } from "@/content/offer";
import { faqPage, webPage, OG_IMAGES } from "@/lib/schema";
import { heroImage, type PageSeo } from "@/lib/seo";

const PATH = "/packages/";
const { title, description, breadcrumb } = offerPage.seo;

const seo: PageSeo = {
  path: PATH,
  title,
  description,
  ogImage: OG_IMAGES.packages,
  lcpArt: { slug: OFFER_HERO_SLUG, sizes: OFFER_HERO_SIZES },
  breadcrumb: { name: breadcrumb, path: PATH },
  jsonLd: [
    webPage({ path: PATH, title, description, primaryImage: heroImage(OFFER_HERO_SLUG, PATH), speakable: true }),
    faqPage(offerPageFaq, PATH),
  ],
};
---

<BaseLayout seo={seo} mainClass="relative bg-bone pt-[var(--header-h)]">
  <OfferHero />
  <OfferModel />
  <OfferScope>
    <ScopeBubble client:visible />
  </OfferScope>
  <OfferCare />
  <OfferOwnership />
  <OfferQuote />
  <OfferFaq />
</BaseLayout>
