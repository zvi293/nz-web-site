---
/**
 * /contact/ — every way to reach the studio, and the signature call "השפופרת".
 * Sections: src/components/contact (static .astro; only <ContactCall> hydrates,
 * client:visible). Content: src/components/contact/content.ts. Styles: contact.css (ct-).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactHero from "@/components/contact/ContactHero.astro";
import ContactCallRoom from "@/components/contact/ContactCallRoom.astro";
import ContactNext from "@/components/contact/ContactNext.astro";
import ContactFaq from "@/components/contact/ContactFaq.astro";
import "@/components/contact/contact.css";
import { contactSeo, contactHero, contactFaq } from "@/components/contact/content";
import { contactPage, faqPage, OG_IMAGES } from "@/lib/schema";
import { heroImage, type PageSeo } from "@/lib/seo";

const PATH = "/contact/";
const { title, description } = contactSeo;
/* Must equal the <Artwork priority sizes> in ContactHero (passed down below). */
const HERO_SIZES = "(min-width: 1280px) 560px, (min-width: 1024px) 40vw, 100vw";
const heroSlug = contactHero.art.slug;

const seo: PageSeo = {
  path: PATH,
  title,
  description,
  ogImage: OG_IMAGES.contact,
  lcpArt: { slug: heroSlug, sizes: HERO_SIZES },
  breadcrumb: { name: "צור קשר", path: PATH },
  jsonLd: [
    contactPage({ path: PATH, title, description, primaryImage: heroImage(heroSlug, PATH), speakable: true }),
    /* Same items, same order, same words as the conversation in ContactFaq. */
    faqPage(contactFaq.items, PATH),
  ],
};
---

<BaseLayout seo={seo} mainClass="relative bg-bone pt-[var(--header-h)]">
  <ContactHero sizes={HERO_SIZES} />
  <ContactCallRoom />
  <ContactNext />
  <ContactFaq />
</BaseLayout>
