---
/**
 * /blog/ — the magazine hub (המגזין). Static sections; behaviour in two small bundled scripts:
 *   MagazineHero      the H1 + lead + the signature "הרוכסן" (MagazineZipper.astro, its own script)
 *   MagazineFilter    sticky department chips (with counts) — filters issue + archive
 *   MagazineIssue     the current issue as a broadsheet front page
 *   MagazineArchive   the earlier articles by department (#dept-<key>), an ink room
 *   MagazineGlossary  the glossary, previewed as a dictionary page
 *   MagazineLetter    closing: a letter to the editor (WhatsApp)
 * JSON-LD: CollectionPage + ItemList (every article) + the Blog node.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import MagazineHero from "@/components/blog/MagazineHero.astro";
import MagazineFilter from "@/components/blog/MagazineFilter.astro";
import MagazineIssue from "@/components/blog/MagazineIssue.astro";
import MagazineArchive from "@/components/blog/MagazineArchive.astro";
import MagazineGlossary from "@/components/blog/MagazineGlossary.astro";
import MagazineLetter from "@/components/blog/MagazineLetter.astro";
import "@/components/blog/magazine.css";
import { blogNode, collectionPage, OG_IMAGES } from "@/lib/schema";
import { getBlogPosts } from "@/lib/blog";
import { getArt } from "@/lib/art";
import { heroImage, type PageSeo } from "@/lib/seo";

const PATH = "/blog/";
const title = "בלוג בניית אתרים: מדריכים לבעלי עסקים | NZ-web";
const description =
  "בלוג בניית אתרים של NZ-web: מדריכים בעברית פשוטה על תכנון אתר לעסק, קידום בגוגל ובמנועי AI, נגישות, עיצוב ומהירות, עם תשובה קצרה בראש כל מאמר.";
/* Must equal the <Artwork priority sizes> in MagazineZipper.astro (passed down from here). */
const HERO_SIZES = "(min-width: 1440px) 670px, (min-width: 1024px) 44vw, calc(100vw - 64px)";
const posts = getBlogPosts();

const seo: PageSeo = {
  path: PATH,
  title,
  description,
  ogImage: OG_IMAGES.blog,
  lcpArt: { slug: "zipper-library", sizes: HERO_SIZES },
  breadcrumb: { name: "המגזין", path: PATH },
  jsonLd: [
    ...collectionPage({
      path: PATH,
      title,
      description,
      primaryImage: heroImage("zipper-library", PATH),
      dateModified: posts[0]?.updated_at ?? posts[0]?.published_at.slice(0, 10),
      speakable: ["h1", ".lead"],
      items: posts.map((p) => ({
        name: p.title,
        path: `/blog/${p.slug}/`,
        description: p.excerpt,
        image: p.art ? getArt(p.art).src : undefined,
      })),
    }),
    blogNode(),
  ],
};
---

<BaseLayout seo={seo} mainClass="relative bg-bone pt-[var(--header-h)]">
  <MagazineHero sizes={HERO_SIZES} />
  <div class="mg-browse">
    <MagazineFilter />
    <MagazineIssue />
    <MagazineArchive />
  </div>
  <MagazineGlossary />
  <MagazineLetter />
</BaseLayout>
