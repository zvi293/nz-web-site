---
/**
 * /blog/ — LEGACY view rendered as ONE island (client:load) until this page is redesigned.
 * The island is server-rendered too, so the full content is in the static HTML. SEO lives here
 * (frontmatter → BaseLayout), never in the view.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Blog from "@/views/Blog";
import { collectionPage, BLOG_ID, ORG_ID, pageUrl, OG_IMAGES } from "@/lib/schema";
import { getBlogPosts } from "@/lib/blog";
import type { PageSeo } from "@/lib/seo";

const PATH = "/blog/";
const title = "בלוג בניית אתרים | מדריכים ו-SEO | NZ-web";
const description =
  "מדריכים, טיפים ותובנות מקצועיות על בניית אתרים, פיתוח אתרים, עיצוב UI/UX וקידום SEO בישראל. תוכן מניסיון אמיתי מהשטח.";
const posts = getBlogPosts();
const seo: PageSeo = {
  path: PATH,
  title,
  description,
  ogImage: OG_IMAGES.blog,
  breadcrumb: { name: "בלוג", path: PATH },
  jsonLd: [
    ...collectionPage({
      path: PATH,
      title,
      description,
      items: posts.map((p) => ({ name: p.title, path: `/blog/${p.slug}/`, description: p.excerpt })),
    }),
    {
      "@type": "Blog",
      "@id": BLOG_ID,
      name: "הבלוג של NZ-web",
      url: pageUrl(PATH),
      inLanguage: "he",
      publisher: { "@id": ORG_ID },
    },
  ],
};
---

<BaseLayout seo={seo}>
  <Blog client:load />
</BaseLayout>
