---
/**
 * /faq/ — the questions, as a harp. Sections: src/components/faq (static .astro; the signature
 * "המיתרים" enhances native <details> with a small bundled script, no React).
 * Content: src/content/faq.ts. Styles: faq.css (fq-).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import FaqHero from "@/components/faq/FaqHero.astro";
import FaqStrings from "@/components/faq/FaqStrings.astro";
import FaqCta from "@/components/faq/FaqCta.astro";
import "@/components/faq/faq.css";
import { faqPage, webPage, OG_IMAGES } from "@/lib/schema";
import { faqSeo, visibleFaqItems } from "@/content/faq";
import { heroImage, type PageSeo } from "@/lib/seo";

const PATH = "/faq/";
const { title, description } = faqSeo;
/* Must equal the <Artwork priority sizes> in FaqHero (passed down below). */
const HERO_SIZES = "(min-width: 1440px) 780px, (min-width: 1024px) 55vw, calc(100vw - 64px)";
const HERO_SLUG = "harp-bridge";

/* The page renders the groups in this same order (before → build → after), so the JSON-LD
   order equals the visible order. */
const seo: PageSeo = {
  path: PATH,
  title,
  description,
  ogImage: OG_IMAGES.faq,
  lcpArt: { slug: HERO_SLUG, sizes: HERO_SIZES },
  breadcrumb: { name: "שאלות נפוצות", path: PATH },
  jsonLd: [
    webPage({ path: PATH, title, description, primaryImage: heroImage(HERO_SLUG, PATH), speakable: true }),
    faqPage(
      visibleFaqItems.map((i) => ({ question: i.question, answer: i.answer })),
      PATH,
    ),
  ],
};
---

<BaseLayout seo={seo} mainClass="relative bg-bone pt-[var(--header-h)]">
  <FaqHero sizes={HERO_SIZES} />
  <FaqStrings />
  <FaqCta />
</BaseLayout>
