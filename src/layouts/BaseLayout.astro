---
/**
 * BaseLayout — the one HTML document shell for every page (SITE-PLAYBOOK §4).
 *
 *   <BaseLayout seo={seo} mainClass="…">  …page sections…  </BaseLayout>
 *
 * The <head> is computed at build time from `seo` (src/lib/seo.ts): title, description,
 * canonical, robots, OG/Twitter, LCP preload, and ONE JSON-LD @graph (site stubs + page nodes).
 * Body: boot script (pre-paint motion gate + saved a11y settings), skip link, <Header> (island,
 * fully server-rendered), <main id="main-content">, <Footer> (static HTML), the global islands
 * (cookie card, accessibility bead, WhatsApp bead) and the bundled global module (src/scripts/global.ts).
 */
import "@/index.css";
import Header from "@/components/Header";
import Footer from "@/components/Footer";
import CookieConsent from "@/components/CookieConsent";
import AccessibilityWidget from "@/components/AccessibilityWidget";
import WhatsAppButton from "@/components/WhatsAppButton";
import { resolveHead, type PageSeo } from "@/lib/seo";

interface Props {
  seo: PageSeo;
  /** Classes for <main id="main-content"> (e.g. the header offset for pages that need it). */
  mainClass?: string;
}

const { seo, mainClass } = Astro.props;
const head = resolveHead(seo);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{head.title}</title>
    <meta name="description" content={head.description} />
    <meta name="author" content="צבי משה, NZ-web" />
    <meta name="robots" content={head.robots} />
    {head.canonical && <link rel="canonical" href={head.canonical} />}
    <meta name="theme-color" content="#EFEAE2" />
    <meta name="geo.region" content="IL" />
    <meta name="geo.country" content="Israel" />
    <meta name="language" content="Hebrew" />
    <meta name="google-site-verification" content="cT5uc8fEuMAXXvVJHQ1zD8rNW8r6s4n6cITOydELpaY" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={head.og.type} />
    <meta property="og:site_name" content="NZ-web" />
    <meta property="og:locale" content="he_IL" />
    {head.og.url && <meta property="og:url" content={head.og.url} />}
    <meta property="og:title" content={head.og.title} />
    <meta property="og:description" content={head.og.description} />
    <meta property="og:image" content={head.og.image} />
    {head.og.imageWidth && <meta property="og:image:width" content={String(head.og.imageWidth)} />}
    {head.og.imageHeight && <meta property="og:image:height" content={String(head.og.imageHeight)} />}
    {head.og.imageType && <meta property="og:image:type" content={head.og.imageType} />}
    {head.og.imageAlt && <meta property="og:image:alt" content={head.og.imageAlt} />}
    {head.article && <meta property="article:published_time" content={head.article.publishedTime} />}
    {head.article && <meta property="article:modified_time" content={head.article.modifiedTime ?? head.article.publishedTime} />}
    {head.article?.section && <meta property="article:section" content={head.article.section} />}
    {head.article && <meta property="article:author" content="https://nz-web.com/about/" />}
    {head.article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={head.og.title} />
    <meta name="twitter:description" content={head.og.description} />
    <meta name="twitter:image" content={head.og.image} />
    {head.og.imageAlt && <meta name="twitter:image:alt" content={head.og.imageAlt} />}

    <!-- Machine-readable profiles -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="author" type="text/plain" href="/humans.txt" />

    <!-- Favicon & manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts: self-hosted (public/fonts). Display Frank Ruhl Libre 300/500/700 (static files),
         text Heebo 400/500/700 (ONE variable file per subset: every Heebo weight points at the same
         URL, so it is downloaded once). Each face is split by unicode-range into Hebrew, Latin
         (ASCII, digits, punctuation — needed on every page) and Latin-ext (accented letters,
         rarely used, so normally never fetched). The faces painted above the fold are preloaded:
         serif 300 + Heebo, Hebrew AND Latin — the Latin files hold the space, digits and the "0"
         that `ch` units measure, so without them the first layout wraps differently (CLS). "Fallback" faces are metric-matched
         local fonts so the swap does not shift the layout. Heebo Fallback has one face per weight
         (400 / 500 → Arial, 700 → Arial Bold): size-adjust = Heebo ÷ Arial advance width of a Hebrew
         paragraph at that weight (104.3 / 106 / 104.5%), so buttons (500) wrap like the real font;
         ascent/descent = Heebo's hhea metrics (2146/862 per 2048) ÷ size-adjust, so line boxes
         match too. Frank Ruhl Fallback (Times) is fitted the same way (105%: Hebrew 300). -->
    <link rel="preload" href="/fonts/frank-ruhl-300-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heebo-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heebo-latin-core.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/frank-ruhl-300-latin-core.woff2" as="font" type="font/woff2" crossorigin />
    <style id="nz-fonts" is:inline set:html={`@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:300;font-display:swap;src:url('/fonts/frank-ruhl-300-hebrew.woff2') format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:300;font-display:swap;src:url('/fonts/frank-ruhl-300-latin-core.woff2') format('woff2');unicode-range:U+0000-00BF,U+00D7,U+00F7,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:300;font-display:swap;src:url('/fonts/frank-ruhl-300-latin-ext.woff2') format('woff2');unicode-range:U+00C0-00D6,U+00D8-00F6,U+00F8-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/frank-ruhl-500-hebrew.woff2') format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/frank-ruhl-500-latin-core.woff2') format('woff2');unicode-range:U+0000-00BF,U+00D7,U+00F7,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/frank-ruhl-500-latin-ext.woff2') format('woff2');unicode-range:U+00C0-00D6,U+00D8-00F6,U+00F8-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/frank-ruhl-700-hebrew.woff2') format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/frank-ruhl-700-latin-core.woff2') format('woff2');unicode-range:U+0000-00BF,U+00D7,U+00F7,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Frank Ruhl Libre';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/frank-ruhl-700-latin-ext.woff2') format('woff2');unicode-range:U+00C0-00D6,U+00D8-00F6,U+00F8-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329}@font-face{font-family:'Heebo';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/heebo-hebrew.woff2') format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F}@font-face{font-family:'Heebo';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/heebo-latin-core.woff2') format('woff2');unicode-range:U+0000-00BF,U+00D7,U+00F7,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Heebo';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/heebo-latin-ext.woff2') format('woff2');unicode-range:U+00C0-00D6,U+00D8-00F6,U+00F8-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329}@font-face{font-family:'Heebo';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/heebo-hebrew.woff2') format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F}@font-face{font-family:'Heebo';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/heebo-latin-core.woff2') format('woff2');unicode-range:U+0000-00BF,U+00D7,U+00F7,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Heebo';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/heebo-latin-ext.woff2') format('woff2');unicode-range:U+00C0-00D6,U+00D8-00F6,U+00F8-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329}@font-face{font-family:'Heebo';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/heebo-hebrew.woff2') format('woff2');unicode-range:U+0307-0308,U+0590-05FF,U+200C-2010,U+20AA,U+25CC,U+FB1D-FB4F}@font-face{font-family:'Heebo';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/heebo-latin-core.woff2') format('woff2');unicode-range:U+0000-00BF,U+00D7,U+00F7,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Heebo';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/heebo-latin-ext.woff2') format('woff2');unicode-range:U+00C0-00D6,U+00D8-00F6,U+00F8-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329}@font-face{font-family:'Frank Ruhl Fallback';src:local('Times New Roman'),local('TimesNewRomanPSMT'),local('David');size-adjust:105%;ascent-override:91%;descent-override:32%;line-gap-override:0%}@font-face{font-family:'Heebo Fallback';font-weight:400;src:local('Arial'),local('ArialMT');size-adjust:104.3%;ascent-override:100.5%;descent-override:40.4%;line-gap-override:0%}@font-face{font-family:'Heebo Fallback';font-weight:500;src:local('Arial'),local('ArialMT');size-adjust:106%;ascent-override:98.9%;descent-override:39.7%;line-gap-override:0%}@font-face{font-family:'Heebo Fallback';font-weight:700;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:104.5%;ascent-override:100.3%;descent-override:40.3%;line-gap-override:0%}`}></style>

    {/* LCP image: fetched before CSS/JS. Same srcset/sizes as the <Artwork priority>. */}
    {head.preload && (
      <link
        id={head.preload.id}
        rel="preload"
        as="image"
        href={head.preload.href}
        imagesrcset={head.preload.imagesrcset}
        imagesizes={head.preload.imagesizes}
        type={head.preload.type}
        fetchpriority="high"
      />
    )}

    <link rel="dns-prefetch" href="https://wa.me" />

    <!-- JSON-LD: ONE @graph per page — #organization, #founder, #website + this page's nodes.
         A data block (not executable): CSP does not apply to it. -->
    <script type="application/ld+json" is:inline set:html={head.jsonLd} />
  </head>

  <body>
    <!-- Boot (runs before first paint): open the motion gate (html.nz-motion) unless reduced
         motion / the a11y widget's pause / an automation browser, and re-apply the visitor's
         saved accessibility settings so they never flash off between pages. Allowed by its
         sha256 in the CSP (scripts/postbuild.mjs writes dist/_headers). Keep it tiny. -->
    <script is:inline>(function(){var d=document,h=d.documentElement,b=d.body,s={};try{s=JSON.parse(localStorage.getItem("a11y-settings-v2")||"{}")||{}}catch(e){}var m={readableFont:"a11y-readable-font",highlightLinks:"a11y-highlight-links",highlightTitles:"a11y-highlight-titles",grayscale:"a11y-grayscale",invertColors:"a11y-invert-colors",pauseAnimations:"a11y-pause-animations",bigCursor:"a11y-big-cursor",readingGuide:"a11y-reading-guide-active",focusOutline:"a11y-focus-outline"};for(var k in m)if(s[k])b.classList.add(m[k]);if(s.highContrastDark)b.classList.add("a11y-high-contrast-dark");else if(s.highContrastLight)b.classList.add("a11y-high-contrast-light");if(s.fontSize&&s.fontSize!==100)h.style.fontSize=s.fontSize+"%";h.classList.add("js");if(!navigator.webdriver&&!s.pauseAnimations&&!matchMedia("(prefers-reduced-motion: reduce)").matches)h.classList.add("nz-motion")})();</script>

    <a
      href="#main-content"
      class="nz-skip sr-only focus:not-sr-only focus:fixed focus:right-4 focus:top-4 focus:z-[10050] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:font-medium focus:text-bone focus:shadow-lg"
    >
      דלג לתוכן הראשי
    </a>

    <Header client:idle pathname={pathname} />

    <main id="main-content" class={mainClass}>
      <slot />
    </main>

    <Footer />

    <CookieConsent client:idle />
    <AccessibilityWidget client:idle />
    <WhatsAppButton client:idle />

    <script>
      import "@/scripts/global";
    </script>
  </body>
</html>
